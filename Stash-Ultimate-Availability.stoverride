script-providers:
  ultimate-chatgpt-web:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://api.openai.com/compliance/cookie_requirements",timeout:8}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data || "").toLowerCase();
        if (body.includes("unsupported_country")) return $done({content:"Blocked",backgroundColor:"#E5484D"});
        $done({content:"Available",backgroundColor:"#10A37F"});
      });

  ultimate-chatgpt-app:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://ios.chat.openai.com",timeout:8,headers:{"User-Agent":"Mozilla/5.0"}}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data || "").toLowerCase();
        if (body.includes("disallowed isp") || body.includes("been blocked") || body.includes("unsupported_country")) {
          return $done({content:"Blocked",backgroundColor:"#E5484D"});
        }
        $done({content:"Available",backgroundColor:"#19C37D"});
      });

  ultimate-codex:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://api.openai.com/compliance/cookie_requirements",timeout:8}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data || "").toLowerCase();
        if (body.includes("unsupported_country")) return $done({content:"Blocked",backgroundColor:"#E5484D"});
        $done({content:"Available",backgroundColor:"#343541"});
      });

  ultimate-claude:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://claude.ai",timeout:8,headers:{"User-Agent":"Mozilla/5.0"}}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data || "").toLowerCase();
        if (/not available in your country|unsupported country|unavailable in your region/.test(body)) {
          return $done({content:"Not Available",backgroundColor:"#E5484D"});
        }
        if (body.includes("claude")) return $done({content:"Available",backgroundColor:"#CC9B7A"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      });

  ultimate-gemini:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://gemini.google.com",timeout:8,headers:{"User-Agent":"Mozilla/5.0"}}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data || "").toLowerCase();
        if (/not available in your country|unsupported country|unavailable in your region/.test(body)) {
          return $done({content:"N/A",backgroundColor:"#E5484D"});
        }
        if (body.includes("gemini")) return $done({content:"Available",backgroundColor:"#4F7DF3"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      });

  ultimate-grok:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://grok.com",timeout:8,headers:{"User-Agent":"Mozilla/5.0"}}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data || "").toLowerCase();
        if (/not available in your country|unsupported country|unavailable in your region|not yet available/.test(body)) {
          return $done({content:"Not Available",backgroundColor:"#E5484D"});
        }
        if (body.includes("grok") || body.includes("xai")) return $done({content:"Available",backgroundColor:"#222222"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      });

  ultimate-copilot:
    interval: 86400
    payload: |
      async function request(method, params) {
        return new Promise((resolve, reject) => {
          const httpMethod = $httpClient[method.toLowerCase()];
          httpMethod(params, (error, response, data) => {
            resolve({ error, response, data });
          });
        });
      }

      async function main() {
        const { error, response, data } = await request(
          "GET",
          "https://copilot.microsoft.com"
        );

        if (error) {
          $done({
            content: "Network Error",
            backgroundColor: "#F59E0B",
          });
          return;
        }
        const body = (data || "").toLowerCase();
        if (
          body.includes("not available in your country") ||
          body.includes("unsupported country") ||
          body.includes("unavailable in your region")
        ) {
          $done({
            content: "N/A",
            backgroundColor: "#E5484D",
          });
          return;
        }

        if (body.includes("copilot") || body.includes("microsoft")) {
          $done({
            content: "Available",
            backgroundColor: "#4F8EF7",
          });
          return;
        }
        $done({
          content: "Unknown",
          backgroundColor: "#F59E0B",
        });
      }

      (async () => {
        main()
          .then((_) => {})
          .catch((error) => {
            $done({});
          });
      })();

  ultimate-youtube:
    interval: 86400
    payload: |
      function extractCountry(body) {
        const patterns = [/"INNERTUBE_CONTEXT_GL"\s*:\s*"([A-Z]{2})"/,/"countryCode"\s*:\s*"([A-Z]{2})"/,/"GL"\s*:\s*"([A-Z]{2})"/,/"gl"\s*:\s*"([A-Z]{2})"/];
        for (const re of patterns) { const m = body.match(re); if (m) return m[1]; }
        if (body.indexOf("www.google.cn") !== -1) return "CN";
        return "";
      }
      $httpClient.get({url:"https://www.youtube.com/",timeout:8,headers:{"User-Agent":"Mozilla/5.0","Accept-Language":"en-US,en;q=0.9"}}, (error,response,data) => {
        if (error || !response) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const status = Number(response.status || response.statusCode || 0);
        const body = String(data || "");
        if (status === 403 || status === 451) return $done({content:"Not Available",backgroundColor:"#E5484D"});
        const ok = body.includes("ytInitialData") || body.includes("INNERTUBE_CONTEXT") || body.includes("youtube.com");
        if (status >= 200 && status < 400 && ok) {
          const cc = extractCountry(body);
          return $done({content:cc ? `Available (${cc})` : "Available",backgroundColor:"#FF0000"});
        }
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      });

  ultimate-netflix:
    interval: 86400
    payload: |
      function checkTitle(id) {
        return new Promise(resolve => {
          $httpClient.get({url:`https://www.netflix.com/title/${id}`,timeout:8,headers:{"User-Agent":"Mozilla/5.0"}}, (error,response,data) => {
            if (error || !response) return resolve({error:true,country:""});
            const headers = response.headers || {};
            const u = headers["X-Originating-Url"] || headers["x-originating-url"] || "";
            if (!u) return resolve({error:false,country:""});
            const parts = u.split("/");
            const loc = parts[3] || "";
            if (loc === "title") return resolve({error:false,country:"US"});
            return resolve({error:false,country:(loc.split("-")[0] || "").toUpperCase()});
          });
        });
      }
      (async () => {
        const full = await checkTitle(70143836);
        if (full.error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        if (full.country) return $done({content:`No Restriction (${full.country})`,backgroundColor:"#E50914"});
        const originals = await checkTitle(80197526);
        if (originals.error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        if (originals.country) return $done({content:`Originals Only (${originals.country})`,backgroundColor:"#E50914"});
        $done({content:"Not Available",backgroundColor:"#E5484D"});
      })().catch(() => $done({content:"Network Error",backgroundColor:"#F59E0B"}));

  ultimate-disney:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://www.disneyplus.com",timeout:8,headers:{"User-Agent":"Mozilla/5.0"}}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data || "").toLowerCase();
        if (/not available in your region|not available in your country|service is unavailable/.test(body)) {
          return $done({content:"N/A",backgroundColor:"#E5484D"});
        }
        if (body.includes("disney")) return $done({content:"Available",backgroundColor:"#2463EB"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      });

  ultimate-spotify:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://spclient.wg.spotify.com/signup/public/v1/account?validate=1&email=test%40test.com",timeout:8,headers:{"User-Agent":"Mozilla/5.0","Accept-Language":"en"}}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        let json = null;
        try { json = JSON.parse(String(data || "")); } catch (_) {}
        if (!json) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const cc = String(json.country || "").toUpperCase();
        if (json.is_country_launched === false) return $done({content:"N/A",backgroundColor:"#E5484D"});
        if (cc) return $done({content:`Available (${cc})`,backgroundColor:"#1DB954"});
        $done({content:"Available",backgroundColor:"#1DB954"});
      });

  ultimate-apple-v2:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://gspe1-ssl.ls.apple.com/pep/gcc",timeout:8}, (error,response,data) => {
        if (error) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const cc = String(data || "").trim().toUpperCase();
        if (/^[A-Z]{2}$/.test(cc)) return $done({content:`Available (${cc})`,backgroundColor:"#5C5C5C"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      });

  ultimate-primevideo:
    interval: 86400
    payload: |
      $httpClient.get({url:"https://www.primevideo.com",timeout:8,headers:{"User-Agent":"Mozilla/5.0","Accept-Language":"en-US,en;q=0.9"}}, (error,response,data) => {
        if (error || !data) return $done({content:"Network Error",backgroundColor:"#F59E0B"});
        const body = String(data);
        if (body.includes("isServiceRestricted")) return $done({content:"Not Available",backgroundColor:"#E5484D"});
        const m = body.match(/"currentTerritory"\s*:\s*"([A-Za-z]{2})"/);
        if (m) return $done({content:`Available (${m[1].toUpperCase()})`,backgroundColor:"#00A8E0"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      });

  ultimate-tiktok:
    interval: 86400
    payload: |
      const UA = "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1";
      function pageRegion(body) {
        const text = String(body || "");
        const patterns = [
          /"region"\s*:\s*"([A-Za-z]{2})"/,
          /"region"\s*:\s*"[A-Za-z]{2}[-_]([A-Za-z]{2})"/,
          /"countryCode"\s*:\s*"([A-Za-z]{2})"/,
          /"country"\s*:\s*"([A-Za-z]{2})"/
        ];
        for (const re of patterns) {
          const m = text.match(re);
          if (m) return m[1].toUpperCase();
        }
        return "";
      }
      function traceRegion(body) {
        const m = String(body || "").match(/(?:^|\n)loc=([A-Za-z]{2})(?:\n|$)/);
        return m ? m[1].toUpperCase() : "";
      }
      function get(url, accept) {
        return new Promise(resolve => {
          $httpClient.get({url:url,timeout:10,headers:{
            "User-Agent":UA,
            "Accept":accept || "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language":"en-US,en;q=0.9"
          }}, (error,response,data) => {
            if (error || !response) return resolve(null);
            resolve({status:Number(response.status || response.statusCode || 0),body:String(data || "")});
          });
        });
      }
      function blocked(res) {
        if (!res) return false;
        const lower = res.body.toLowerCase();
        return res.status === 403 || res.status === 451 || /access denied|not available in your region|tiktok is not available/.test(lower);
      }
      (async () => {
        // Prefer TikTok's own page region. This reflects TikTok's service-side region
        // rather than Cloudflare's generic IP geolocation from cdn-cgi/trace.
        let home = await get("https://www.tiktok.com/");
        if (blocked(home)) return $done({content:"Not Available",backgroundColor:"#E5484D"});
        let cc = home && home.status >= 200 && home.status < 400 ? pageRegion(home.body) : "";

        if (!cc) {
          const explore = await get("https://www.tiktok.com/explore");
          if (blocked(explore)) return $done({content:"Not Available",backgroundColor:"#E5484D"});
          if (explore && explore.status >= 200 && explore.status < 400) cc = pageRegion(explore.body);
        }
        if (cc) return $done({content:`Available (${cc})`,backgroundColor:"#333333"});

        // Fallback only: Cloudflare trace location.
        const trace = await get("https://www.tiktok.com/cdn-cgi/trace","text/plain,*/*");
        if (blocked(trace)) return $done({content:"Not Available",backgroundColor:"#E5484D"});
        if (trace && trace.status >= 200 && trace.status < 300) {
          const loc = traceRegion(trace.body);
          return $done({content:loc ? `Available (${loc})` : "Available",backgroundColor:"#333333"});
        }
        if ((home && home.status >= 200 && home.status < 400)) return $done({content:"Available",backgroundColor:"#333333"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      })().catch(() => $done({content:"Network Error",backgroundColor:"#F59E0B"}));

  ultimate-bilibili:
    interval: 86400
    payload: |
      function probe(url) {
        return new Promise(resolve => {
          $httpClient.get({url:url,timeout:8}, (error,response,data) => {
            if (error || !data) return resolve("error");
            try {
              const json = JSON.parse(data);
              if (json.code === 0) return resolve("ok");
              if (json.code === -10403) return resolve("no");
              return resolve("error");
            } catch (_) { return resolve("error"); }
          });
        });
      }
      (async () => {
        const hmtUrl = "https://api.bilibili.com/pgc/player/web/playurl?avid=18281381&cid=29892777&qn=0&type=&otype=json&ep_id=183799&fourk=1&fnver=0&fnval=16&module=bangumi";
        const cnUrl = "https://api.bilibili.com/pgc/player/web/playurl?avid=82846771&qn=0&type=&otype=json&ep_id=307247&fourk=1&fnver=0&fnval=16&module=bangumi";
        const result = await Promise.all([probe(hmtUrl), probe(cnUrl)]);
        const hmt = result[0], cn = result[1];
        if (hmt === "ok" && cn === "ok") return $done({content:"Available (CN/HMT)",backgroundColor:"#FB7299"});
        if (hmt === "ok") return $done({content:"Available (HMT)",backgroundColor:"#FB7299"});
        if (cn === "ok") return $done({content:"Available (CN)",backgroundColor:"#FB7299"});
        if (hmt === "no" && cn === "no") return $done({content:"Not Available",backgroundColor:"#E5484D"});
        $done({content:"Network Error",backgroundColor:"#F59E0B"});
      })().catch(() => $done({content:"Network Error",backgroundColor:"#F59E0B"}));
